---
const { titulo, descripcion } = Astro.props;
import "@styles/global.css";
import "@fontsource-variable/ibm-plex-sans";
import "@fontsource/ibm-plex-mono";
import Footer from "@sections/footer/index.astro";

import ProfileCard from "@sections/profilecard/index.astro";
import { StackCard } from "@/sections/habilidades";


---

<!doctype html>
<html lang="es">
  <head>
    <link rel="icon" type="image/png" href="/Dev JL Logo.png" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
  </head>
  <body class="bg-neutral-100  px-4 py-6 flex flex-col gap-3.5">
    <main class="grid grid-cols-1 md:grid-cols-3 gap-5 container max-w-4xl mx-auto">
      <aside class="md:col-span-1 gap-6 flex flex-col">
        <ProfileCard />
        <StackCard />       
      </aside>
      <slot />
    </main>
    <Footer />
  </body>
</html>
