---
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.postDate.valueOf() - a.data.postDate.valueOf(),
);

import ConsoleBox from "@components/astro/ui/consolebox/index.astro";
---

<ConsoleBox style="grid-area: blog;">
  <h2 class="">Mi Blog</h2>
  <ul class="flex flex-wrap gap-y-2 ">
    {
      posts.map((post) => {
        const { id, data } = post;
        const { title, postDate } = data;

        return (
          <li class="btn btn-ghost btn-block max-[30rem]:btn-sm sm:btn-lg">
            <a href={`/blog/${id}`}>
              <h4>{title}</h4>
              <time datetime={postDate.toISOString()}>
                {postDate.toLocaleDateString("es-CO", {
                  weekday: "long",
                  year: "numeric",
                  month: "short",
                  day: "numeric",
                })}
              </time>
            </a>
          </li>
        );
      })
    }
  </ul>
</ConsoleBox>
