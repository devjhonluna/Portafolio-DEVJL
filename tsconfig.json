{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@js/*": [
        "./src/components/js/*"
      ],
      "@styles/*": [
        "./src/styles/*"
      ],
      "@layouts/*": [
        "./src/layouts/*"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "@assets/*": [
        "./src/assets/*"
      ],
      "@sections/*": [
        "./src/sections/*"
      ],
      "@utils/*":[
        "./src/utils/*"
      ]
    },
    "jsx": "preserve"
  }
}